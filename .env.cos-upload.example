# Copy this file to .env.cos-upload and fill it locally.
# Never commit .env.cos-upload or paste credentials into source files.
COS_SECRET_ID=
COS_SECRET_KEY=
COS_SESSION_TOKEN=
COS_BUCKET=
COS_REGION=
COS_PUBLIC_BASE_URL=https://img.example.com
COS_PUBLIC_REFERER=https://example.com/
COS_OBJECT_PREFIX=blog/images
COS_IMAGE_QUALITY=82
